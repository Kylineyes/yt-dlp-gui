import { Button, VerticalBox } from "std-widgets.slint";

component NavigationButton inherits Button {
    in property <bool> active;
    primary: active;
    checked: active;
    colorize-icon: true;
    horizontal-stretch: 1;
}

export component Sidebar inherits Rectangle {
    in-out property <int> selected-page;
    callback refresh-downloads();

    width: 224px;
    background: #f3f3f3;
    border-width: 0px;

    VerticalBox {
        padding: 16px;
        spacing: 8px;
        Text { text: @tr("yt-dlp Integration Platform"); font-size: 22px; font-weight: 600; color: #202020; }
        Text { text: @tr("Download manager"); color: #666666; }
        Rectangle { height: 14px; }
        NavigationButton {
            text: @tr("Welcome");
            icon: @image-url("../assets/icons/home.svg");
            enabled: false;
            active: false;
        }
        NavigationButton {
            text: @tr("Settings");
            icon: @image-url("../assets/icons/settings.svg");
            active: root.selected-page == 0;
            clicked => { root.selected-page = 0; }
        }
        NavigationButton {
            text: @tr("Search");
            icon: @image-url("../assets/icons/search.svg");
            active: root.selected-page == 1;
            clicked => { root.selected-page = 1; }
        }
        NavigationButton {
            text: @tr("Download tasks");
            icon: @image-url("../assets/icons/bookmark.svg");
            active: root.selected-page == 2;
            clicked => {
                root.selected-page = 2;
                root.refresh-downloads();
            }
        }
        NavigationButton {
            text: @tr("Settings");
            icon: @image-url("../assets/icons/settings.svg");
            active: root.selected-page == 3;
            clicked => { root.selected-page = 3; }
        }
        Rectangle { vertical-stretch: 1; }
    }
}
