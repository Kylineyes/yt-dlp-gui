export struct ThemeTokens {
    page: color,
    sidebar: color,
    card: color,
    muted: color,
    hover: color,
    selected: color,
    border: color,
    border-hover: color,
    border-focus: color,
    primary: color,
    secondary: color,
    tertiary: color,
    disabled: color,
    on-accent: color,
    accent: color,
    accent-hover: color,
    accent-pressed: color,
    success: color,
    success-surface: color,
    warning: color,
    warning-surface: color,
    danger: color,
    danger-surface: color,
    info-surface: color,
    shadow: color,
}

export struct StreamRow {
    id: string,
    label: string,
    format-selector: string,
    video-format: string,
    audio-format: string,
    estimated-size: string,
    selected: bool,
}

export enum ToastKind { success, error, validation-error }

export struct ToastData {
    id: int,
    kind: ToastKind,
    detail: string,
}

export struct DownloadRow {
    id: int,
    name: string,
    url: string,
    status: string,
    started-at: string,
    completed-at: string,
    output-directory: string,
    size-text: string,
    format-text: string,
    progress: float,
    error-message: string,
}
