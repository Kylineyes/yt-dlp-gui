import { Button, LineEdit, ListView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { StreamRow } from "types.slint";

export component SearchPage inherits Rectangle {
    in-out property <string> url;
    in-out property <string> output-directory;
    in property <string> default-download-directory;
    in property <string> resource-name;
    in property <int> message-kind;
    in property <string> message-argument;
    in property <[StreamRow]> streams;
    in property <bool> search-in-progress;
    in property <int> selected-stream-index: -1;
    callback url-edited();
    callback select-output-directory(string);
    callback search();
    callback select-stream(int);
    callback create-download();

    background: #fafafa;
    VerticalBox {
        padding: 28px;
        spacing: 10px;
        Text { text: @tr("Search"); font-size: 28px; font-weight: 600; }
        Text { text: @tr("Enter a link, review available media streams, and create a download task"); color: #666666; }
        HorizontalBox {
            spacing: 8px;
            LineEdit {
                placeholder-text: @tr("Enter a video or playlist URL");
                text <=> root.url;
                enabled: !root.search-in-progress;
                edited => { root.url-edited(); }
                horizontal-stretch: 1;
            }
            Button { text: @tr("Search"); primary: true; enabled: !root.search-in-progress; clicked => { root.search(); } }
        }
        Text { text: root.resource-name; font-size: 18px; font-weight: 600; }
        Rectangle {
            border-width: 1px;
            border-color: #dedede;
            border-radius: 6px;
            vertical-stretch: 1;
            ListView {
                for stream[index] in root.streams : Rectangle {
                    height: 82px;
                    background: stream.selected ? #e5f1fb : Math.mod(index, 2) == 0 ? #ffffff : #f7f7f7;
                    border-radius: 4px;
                    TouchArea { clicked => { root.select-stream(index); } }
                    VerticalBox {
                        padding: 10px;
                        spacing: 3px;
                        Text {
                            text: stream.id + "  ·  " + stream.label;
                            font-weight: 600;
                        }
                        Text {
                            text: stream.video-format == "" ? @tr("Audio only") :
                                  stream.audio-format == "" ? @tr("Video only") :
                                  @tr("Video: ") + stream.video-format + "  ·  " + @tr("Audio: ") + stream.audio-format;
                            color: #555555;
                        }
                        Text { text: @tr("Size: ") + stream.estimated-size; color: #777777; }
                    }
                }
            }
        }
        Text { text: @tr("Download location"); font-weight: 600; }
        HorizontalBox {
            spacing: 8px;
            LineEdit {
                placeholder-text: @tr("Choose a download directory");
                text <=> root.output-directory;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Load default location");
                clicked => { root.output-directory = root.default-download-directory; }
            }
            Button {
                text: @tr("Browse…");
                clicked => { root.select-output-directory(@tr("Select download directory")); }
            }
        }
        HorizontalBox {
            Button {
                text: @tr("Add download task");
                primary: true;
                enabled: !root.search-in-progress && root.selected-stream-index >= 0;
                clicked => { root.create-download(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: root.message-kind == 1 ? @tr("Enter a URL to search") :
                  root.message-kind == 2 ? @tr("Formats loaded; choose a format and add the task") :
                  root.message-kind == 4 ? @tr("Select a media stream first") :
                  root.message-kind == 5 ? @tr("Enter a download location") :
                  root.message-kind == 6 ? @tr("Analyzing with yt-dlp...") :
                  root.message-kind == 7 ? @tr("No downloadable formats were found") :
                  root.message-kind == 8 ? root.message-argument :
                  root.message-argument;
            color: #2563eb;
            wrap: word-wrap;
        }
    }
}
