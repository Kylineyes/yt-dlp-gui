import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ToastData, ToastKind } from "../types.slint";

export enum ValidationStatus { checking, valid, invalid }


component ToastItem inherits Rectangle {
    in property <ThemeTokens> theme;
    in property <ToastData> data;
    callback dismissed(int);
    private property <float> visual-opacity: 0;
    private property <float> countdown-progress: 1;
    private property <bool> closing: false;
    private property <bool> dismiss-hovered: false;
    private property <bool> dismiss-pressed: false;

    opacity: root.visual-opacity;
    animate countdown-progress {
        duration: root.closing ? 240ms : (root.data.kind == ToastKind.success ? 3000ms : 6000ms);
        easing: linear;
    }
    height: 64px;
    width: content.preferred-width;
    background: root.data.kind == ToastKind.success ? Theme.toast-success : Theme.toast-danger;
    border-radius: 7px;
    drop-shadow-blur: 8px;
    drop-shadow-color: Theme.shadow;
    // Keep entrance fast while giving dismissal a clearly visible fade.
    animate visual-opacity { duration: root.closing ? 240ms : 80ms; easing: ease-in-out; }

    init => {
        root.visual-opacity = 1;
        lifetime-timer.start();
        countdown-start-timer.start();
    }

    countdown-start-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => { root.countdown-progress = 0; }
    }

    lifetime-timer := Timer {
        interval: root.data.kind == ToastKind.success ? 2760ms : 5760ms;
        running: false;
        triggered => { root.begin-close(); }
    }

    remove-timer := Timer {
        interval: 240ms;
        running: false;
        triggered => { root.dismissed(root.data.id); }
    }

    function begin-close() {
        if (!root.closing) {
            root.closing = true;
            lifetime-timer.stop();
            countdown-start-timer.stop();
            root.countdown-progress = 0;
            root.visual-opacity = 0;
            remove-timer.start();
        }
    }

    content := HorizontalBox {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        alignment: center;
        Text {
            text: root.data.kind == ToastKind.success ? @tr("Settings saved") :
                  root.data.kind == ToastKind.validation-error ? @tr("Fix invalid settings before saving") :
                  root.data.detail == "" ? @tr("Operation failed") : @tr("Operation failed: {}", root.data.detail);
            color: Theme.text-on-solid;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-label: root.data.kind == ToastKind.success ? @tr("Success") :
                              root.data.kind == ToastKind.validation-error ? @tr("Validation error") : @tr("Error");
        }
        dismiss-control := Rectangle {
            width: 36px;
            height: 36px;
            background: root.dismiss-pressed ? #66FFFFFF : root.dismiss-hovered ? #33FFFFFF : transparent;
            border-radius: 6px;
            Text {
                width: parent.width;
                height: parent.height;
                text: "×";
                color: #FFFFFF;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: @tr("Dismiss");
                clicked => { root.begin-close(); }
                changed has-hover => { root.dismiss-hovered = self.has-hover; }
                changed pressed => { root.dismiss-pressed = self.pressed; }
            }
        }
    }

    countdown-viewport := Rectangle {
        x: 0px;
        y: root.height - self.height;
        width: root.width;
        height: 3px;
        clip: true;
        background: Theme.text-on-solid.with-alpha(0.2);
        countdown-bar := Rectangle {
            x: parent.width - self.width;
            y: 0px;
            width: parent.width * root.countdown-progress;
            height: parent.height;
            background: Theme.text-on-solid.with-alpha(0.8);
        }
    }
}

export component ToastHost inherits Rectangle {
    in property <ThemeTokens> theme;
    in property <[ToastData]> toasts;
    callback dismissed(int);

    background: transparent;
    stack := VerticalBox {
        y: root.height - self.height - 24px;
        width: root.width;
        height: self.preferred-height;
        spacing: 8px;
        for toast in root.toasts : Rectangle {
            height: 72px;
            toast-item := ToastItem {
                theme: root.theme;
                x: (parent.width - self.width) / 2;
                data: toast;
                dismissed(id) => { root.dismissed(id); }
            }
        }
    }
}
