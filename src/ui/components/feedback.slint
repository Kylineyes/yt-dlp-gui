import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { ToastData, ThemeTokens } from "../types.slint";

export enum ToastKind { success, error, validation-error }


component ToastItem inherits Rectangle {
    in property <ThemeTokens> theme;
    in property <ToastData> data;
    callback dismissed(int);
    private property <float> visual-opacity: 0;
    private property <float> countdown-progress: 1;
    private property <bool> closing: false;

    opacity: root.visual-opacity;
    animate countdown-progress {
        duration: root.closing ? 240ms : (root.data.kind == 0 ? 3000ms : 6000ms);
        easing: linear;
    }
    height: 64px;
    width: content.preferred-width;
    background: root.data.kind == 0 ? root.theme.success : root.theme.danger;
    border-radius: 7px;
    drop-shadow-blur: 8px;
    drop-shadow-color: #66000000;
    // Keep entrance fast while giving dismissal a clearly visible fade.
    animate visual-opacity { duration: root.closing ? 240ms : 80ms; easing: ease-in-out; }

    init => {
        // Start fully visible; the short animation is reserved for dismissal.
        root.visual-opacity = 1;
        lifetime-timer.start();
        countdown-start-timer.start();
    }

    countdown-start-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => { root.countdown-progress = 0; }
    }

    lifetime-timer := Timer {
        interval: root.data.kind == 0 ? 2760ms : 5760ms;
        running: false;
        triggered => { root.begin-close(); }
    }

    remove-timer := Timer {
        interval: 240ms;
        running: false;
        triggered => {
            root.dismissed(root.data.id);
        }
    }

    function begin-close() {
        if (!root.closing) {
            root.closing = true;
            lifetime-timer.stop();
            countdown-start-timer.stop();
            root.countdown-progress = 0;
            root.visual-opacity = 0;
            remove-timer.start();
        }
    }

    content := HorizontalBox {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        alignment: center;
        Text {
            text: root.data.kind == 0 ? @tr("Settings saved") :
                  root.data.kind == 2 ? @tr("Fix invalid settings before saving") :
                  root.data.detail == "" ? @tr("Operation failed") : @tr("Operation failed: {}", root.data.detail);
            color: root.theme.on-accent;
            vertical-alignment: center;
        }
        Rectangle {
            width: dismiss-button.preferred-width;
            height: 48px;
            vertical-stretch: 1;
            dismiss-button := Button {
                x: 0px;
                y: (parent.height - self.preferred-height) / 2;
                width: self.preferred-width;
                height: self.preferred-height;
                text: @tr("Dismiss");
                clicked => { root.begin-close(); }
            }
        }
    }

    countdown-viewport := Rectangle {
        x: 0px;
        y: root.height - self.height;
        width: root.width;
        height: 3px;
        clip: true;
        background: #ffffff33;
        countdown-bar := Rectangle {
            x: parent.width - self.width;
            y: 0px;
            width: parent.width * root.countdown-progress;
            height: parent.height;
            background: #ffffffcc;
        }
    }
}

export component ToastHost inherits Rectangle {
    in property <ThemeTokens> theme;
    in property <[ToastData]> toasts;
    callback dismissed(int);

    background: transparent;
    stack := VerticalBox {
        y: root.height - self.height - 24px;
        width: root.width;
        height: self.preferred-height;
        spacing: 8px;
        for toast in root.toasts : Rectangle {
            height: 64px;
            toast-item := ToastItem {
                theme: root.theme;
                x: (parent.width - self.width) / 2;
                data: toast;
                dismissed(id) => { root.dismissed(id); }
            }
        }
    }
}
