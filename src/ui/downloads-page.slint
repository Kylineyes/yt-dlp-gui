import { Button, ListView, ProgressIndicator, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DownloadRow } from "types.slint";

export component DownloadsPage inherits Rectangle {
    in property <[DownloadRow]> downloads;
    in property <int> message-kind;
    in property <string> message-argument;
    in property <int> message-task-id;
    in property <string> message-detail;
    callback refresh();
    callback start(int);
    callback pause(int);

    background: Theme.surface-page;
    VerticalBox {
        padding: 28px;
        spacing: 10px;
        HorizontalBox {
            VerticalBox {
                Text { text: @tr("Download tasks"); font-size: 28px; font-weight: 600; }
                Text { text: @tr("Download history and current task status"); color: Theme.text-secondary; }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Refresh"); clicked => { root.refresh(); } }
        }
        Text {
            text: root.message-kind == 1 ? @tr("Background service is ready") :
                  root.message-kind == 2 ? @tr("{} download tasks", root.message-argument) :
                  root.message-kind == 3 ? @tr("Task {} is downloading", root.message-task-id) :
                  root.message-kind == 4 ? @tr("Task {}: {}", root.message-task-id, root.message-detail) :
                  root.message-kind == 5 ? @tr("Task {} completed", root.message-task-id) :
                  root.message-kind == 6 ? @tr("Task {} failed: {}", root.message-task-id, root.message-detail) :
                  root.message-kind == 7 ? @tr("Task {} cannot be paused yet; the app will not fake a paused state", root.message-task-id) :
                  root.message-kind == 8 ? @tr("Task added to the download list") :
                  root.message-argument;
            color: Theme.accent;
            wrap: word-wrap;
        }
        ListView {
            for task in root.downloads : Rectangle {
                height: 194px;
                background: Theme.surface-card;
                border-width: 1px;
                border-color: Theme.border-default;
                border-radius: 7px;
                VerticalBox {
                    padding: 13px;
                    spacing: 5px;
                    HorizontalBox {
                        Text { text: task.name == "" ? @tr("Unnamed resource") : task.name; font-size: 17px; font-weight: 600; horizontal-stretch: 1; }
                        Text {
                            text: task.status == "queued" ? @tr("Queued") :
                                  task.status == "ready" ? @tr("Ready") :
                                  task.status == "running" ? @tr("Downloading") :
                                  task.status == "paused" ? @tr("Pause") :
                                  task.status == "completed" ? @tr("Completed") :
                                  @tr("Failed");
                            color: task.status == "failed" ? Theme.danger : task.status == "completed" ? Theme.success : Theme.accent;
                            font-weight: 600;
                        }
                    }
                    Text { text: task.url; color: Theme.text-secondary; }
                    Text { text: @tr("Format: {}", task.format-text); color: Theme.text-secondary; }
                    Text { text: @tr("Location: {}", task.output-directory); color: Theme.text-secondary; }
                    Text { text: @tr("Started: {}    Completed: {}", task.started-at, task.completed-at); color: Theme.text-tertiary; }
                    ProgressIndicator { progress: task.progress; }
                    Text { text: @tr("Size: {}", task.size-text); color: Theme.text-secondary; }
                    HorizontalBox {
                        spacing: 8px;
                        Button { text: @tr("Start"); enabled: task.status == "queued" || task.status == "ready" || task.status == "failed"; clicked => { root.start(task.id); } }
                        Button { text: @tr("Pause"); enabled: task.status == "running"; clicked => { root.pause(task.id); } }
                        Text { text: task.error-message; color: Theme.danger; horizontal-stretch: 1; }
                    }
                }
            }
        }
    }
}
