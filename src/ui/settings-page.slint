import { Button, ComboBox, LineEdit, ScrollView, SpinBox, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ValidationIndicator, ValidationStatus } from "components/feedback.slint";

component SettingsLabel inherits Text {
    in property <ThemeTokens> theme;
    color: root.theme.primary;
    font-size: 14px;
    font-weight: 600;
    vertical-alignment: center;
}

component SettingsInput inherits Rectangle {
    in property <ThemeTokens> theme;
    in-out property <string> text;
    in property <string> placeholder-text;

    height: 36px;
    background: root.theme.card;
    border-width: 1px;
    border-color: input.has-focus ? root.theme.border-focus : root.theme.border;
    border-radius: 6px;

    input := LineEdit {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        text <=> root.text;
        placeholder-text: root.placeholder-text;
    }

    public function focus-field() {
        input.focus();
    }

    public function select-field() {
        input.select-all();
    }
}

component SettingsCard inherits Rectangle {
    in property <ThemeTokens> theme;
    in property <string> title;

    horizontal-stretch: 1;
    background: root.theme.card;
    border-width: 1px;
    border-color: root.theme.border;
    border-radius: 8px;

    card-content := VerticalBox {
        width: parent.width;
        height: self.preferred-height;
        padding: 16px;
        spacing: 16px;
        Text {
            text: root.title;
            color: root.theme.primary;
            font-size: 16px;
            font-weight: 600;
        }
        @children
    }
    height: card-content.preferred-height;
}

component SettingsError inherits Rectangle {
    in property <ThemeTokens> theme;
    in property <string> text;

    background: root.theme.danger-surface;
    border-radius: 6px;

    error-content := HorizontalBox {
        width: parent.width;
        height: self.preferred-height;
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        Text {
            text: root.text;
            color: root.theme.danger;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }
    height: error-content.preferred-height;
}

export component SettingsPage inherits Rectangle {
    in property <ThemeTokens> theme;
    in-out property <string> theme-mode: "system";
    in-out property <string> yt-dlp-path;
    in-out property <string> ffmpeg-path;
    in-out property <string> default-download-directory;
    in-out property <string> proxy;
    in-out property <int> max-concurrency;
    in-out property <string> language;
    in-out property <string> theme-preference: "system";
    in-out property <ValidationStatus> yt-dlp-status;
    in-out property <ValidationStatus> ffmpeg-status;
    in-out property <ValidationStatus> download-directory-status;
    in-out property <ValidationStatus> proxy-status;
    in property <int> invalid-field: -1;
    in property <int> invalid-revision;
    in-out property <bool> pending-save;
    in-out property <int> yt-dlp-error-kind;
    in-out property <int> ffmpeg-error-kind;
    in-out property <int> download-directory-error-kind;
    in-out property <int> proxy-error-kind;
    in property <int> message-kind;
    in property <string> message-argument;
    callback save();
    callback reset();
    callback change-language(string);
    callback change-theme-preference(string);
    callback validate(int);
    callback select-yt-dlp(string);
    callback select-ffmpeg(string);
    callback select-download-directory(string);
    public function focus-invalid-field(field: int) {
        if (field == 0) {
            yt-dlp-input.focus-field();
            yt-dlp-input.select-field();
        } else if (field == 1) {
            ffmpeg-input.focus-field();
            ffmpeg-input.select-field();
        } else if (field == 2) {
            download-directory-input.focus-field();
            download-directory-input.select-field();
        } else {
            proxy-input.focus-field();
            proxy-input.select-field();
        }
    }

    changed invalid-revision => { root.focus-invalid-field(root.invalid-field); }
    changed yt-dlp-path => { root.yt-dlp-error-kind = 0; }
    changed ffmpeg-path => { root.ffmpeg-error-kind = 0; }
    changed default-download-directory => { root.download-directory-error-kind = 0; }
    changed proxy => { root.proxy-error-kind = 0; }

    background: Theme.surface-page;
    ScrollView {
        VerticalBox {
            padding: 28px;
            spacing: 10px;
            Text { text: @tr("Settings"); font-size: 28px; font-weight: 600; }
            Text { text: @tr("Configure yt-dlp and the download environment"); color: Theme.text-secondary; }
            Rectangle { height: 12px; }
            SettingLabel { label: @tr("yt-dlp path"); status: root.yt-dlp-status; }
            HorizontalBox {
                spacing: 8px;
                Text {
                    text: @tr("Settings");
                    color: root.theme.primary;
                    font-size: 28px;
                    font-weight: 600;
                }
                Button { text: @tr("Browse…"); clicked => { root.select-yt-dlp(@tr("Select yt-dlp executable")); } }
            }
            if root.yt-dlp-error-kind != 0 : Text {
                text: root.yt-dlp-error-kind == 1 ? @tr("Remove leading or trailing whitespace") :
                      root.yt-dlp-error-kind == 2 ? @tr("Path does not exist or is not a file") :
                      @tr("The executable could not be started");
                color: Theme.danger;
            }
            SettingLabel { label: @tr("FFmpeg path"); status: root.ffmpeg-status; }
            HorizontalBox {
                spacing: 8px;
                ffmpeg-input := LineEdit {
                    placeholder-text: @tr("Enter ffmpeg.exe or its directory");
                    text <=> root.ffmpeg-path;
                    horizontal-stretch: 1;
                    changed has-focus => { if (!self.has-focus) { root.validate(1); } }
                }
                Button { text: @tr("Browse…"); clicked => { root.select-ffmpeg(@tr("Select FFmpeg executable")); } }
            }
            if root.ffmpeg-error-kind != 0 : Text {
                text: root.ffmpeg-error-kind == 1 ? @tr("Remove leading or trailing whitespace") :
                      root.ffmpeg-error-kind == 2 ? @tr("Path does not exist or is not a file") :
                      @tr("The executable could not be started");
                color: Theme.danger;
            }

            SettingsCard {
                theme: root.theme;
                title: @tr("Required tool environment configuration");
                VerticalBox {
                    spacing: 16px;
                    SettingsLabel { theme: root.theme; text: @tr("yt-dlp path"); }
                    HorizontalBox {
                        spacing: 8px;
                        yt-dlp-input := SettingsInput {
                            theme: root.theme;
                            placeholder-text: @tr("Leave empty to find yt-dlp.exe on PATH");
                            text <=> root.yt-dlp-path;
                            horizontal-stretch: 1;
                        }
                        Button {
                            height: 36px;
                            text: @tr("Browse…");
                            clicked => { root.select-yt-dlp(@tr("Select yt-dlp executable")); }
                        }
                    }
                    if root.yt-dlp-error-kind != 0 : SettingsError {
                        theme: root.theme;
                        text: root.yt-dlp-error-kind == 1 ? @tr("Remove leading or trailing whitespace") :
                              root.yt-dlp-error-kind == 2 ? @tr("Path does not exist or is not a file") :
                              @tr("The executable could not be started");
                    }

                    SettingsLabel { theme: root.theme; text: @tr("FFmpeg path"); }
                    HorizontalBox {
                        spacing: 8px;
                        ffmpeg-input := SettingsInput {
                            theme: root.theme;
                            placeholder-text: @tr("Enter ffmpeg.exe or its directory");
                            text <=> root.ffmpeg-path;
                            horizontal-stretch: 1;
                        }
                        Button {
                            height: 36px;
                            text: @tr("Browse…");
                            clicked => { root.select-ffmpeg(@tr("Select FFmpeg executable")); }
                        }
                    }
                    if root.ffmpeg-error-kind != 0 : SettingsError {
                        theme: root.theme;
                        text: root.ffmpeg-error-kind == 1 ? @tr("Remove leading or trailing whitespace") :
                              root.ffmpeg-error-kind == 2 ? @tr("Path does not exist or is not a file") :
                              @tr("The executable could not be started");
                    }
                }
                Button { text: @tr("Browse…"); clicked => { root.select-download-directory(@tr("Select download directory")); } }
            }
            if root.download-directory-error-kind != 0 : Text {
                text: root.download-directory-error-kind == 1 ? @tr("Remove leading or trailing whitespace") :
                      @tr("Download directory does not exist or is not a directory");
                color: Theme.danger;
            }
            SettingLabel { label: @tr("Download proxy"); status: root.proxy-status; }
            proxy-input := LineEdit {
                placeholder-text: @tr("For example: http://127.0.0.1:7890");
                text <=> root.proxy;
                changed has-focus => { if (!self.has-focus) { root.validate(3); } }
            }
            if root.proxy-error-kind != 0 : Text {
                text: @tr("Remove leading or trailing whitespace");
                color: Theme.danger;
            }

            SettingsCard {
                theme: root.theme;
                title: @tr("General");
                VerticalBox {
                    spacing: 8px;
                    SettingsLabel { theme: root.theme; text: @tr("Language"); }
                    ComboBox {
                        height: 36px;
                        model: [@tr("Simplified Chinese"), @tr("English")];
                        current-index: root.language == "en" ? 1 : 0;
                        selected(value) => {
                            root.language = self.current-index == 1 ? "en" : "zh-CN";
                            root.change-language(root.language);
                        }
                    }
                    SettingsLabel { theme: root.theme; text: @tr("Theme"); }
                    ComboBox {
                        height: 36px;
                        model: [@tr("Light"), @tr("Dark"), @tr("Follow system")];
                        current-index: root.theme-mode == "light" ? 0 : root.theme-mode == "dark" ? 1 : 2;
                        selected(value) => {
                            root.theme-mode = self.current-index == 0 ? "light" : self.current-index == 1 ? "dark" : "system";
                            root.change-theme(root.theme-mode);
                        }
                    }
                }
            }
            Text { text: @tr("Appearance"); font-weight: 600; }
            ComboBox {
                model: [@tr("Follow system"), @tr("Light"), @tr("Dark")];
                current-index: root.theme-preference == "light" ? 1 : root.theme-preference == "dark" ? 2 : 0;
                selected(value) => {
                    root.theme-preference = self.current-index == 1 ? "light" : self.current-index == 2 ? "dark" : "system";
                    root.change-theme-preference(root.theme-preference);
                }
            }
            Text { text: @tr("Maximum concurrent downloads"); font-weight: 600; }
            SpinBox { minimum: 1; maximum: 16; value <=> root.max-concurrency; }
            Text { text: @tr("This version saves the concurrency setting, but downloads still run one at a time."); color: Theme.warning; wrap: word-wrap; }
            HorizontalBox {
                spacing: 8px;
                Button { text: @tr("Save settings"); primary: true; enabled: !root.pending-save; clicked => { root.save(); } }
                Button { text: @tr("Restore defaults"); clicked => { root.reset(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: root.message-kind == 2 ? @tr("Defaults restored; click Save settings") : root.message-argument;
                color: Theme.accent;
                wrap: word-wrap;
            }
        }
    }
}
