import { Button, HorizontalBox, TextEdit, VerticalBox, Palette } from "std-widgets.slint";
import { Sidebar } from "sidebar.slint";
import { StreamRow, DownloadRow, ToastData, ThemeTokens } from "ui/types.slint";
import { ToastHost } from "ui/components/feedback.slint";
import { SettingsPage } from "ui/settings-page.slint";
import { SearchPage } from "ui/search-page.slint";
import { DownloadsPage } from "ui/downloads-page.slint";
import { WelcomePage } from "ui/welcome-page.slint";

export component MainWindow inherits Window {
    title: @tr("yt-dlp GUI");
    width: 1120px;
    height: 720px;

    in-out property <int> selected-page: 0;
    in-out property <string> yt-dlp-path;
    in-out property <string> ffmpeg-path;
    in-out property <string> default-download-directory;
    in-out property <string> proxy;
    in-out property <int> max-concurrency: 1;
    in-out property <string> language: "zh-CN";
    in-out property <string> theme-mode: "system";
    property <bool> dark-theme: root.theme-mode == "dark" || (root.theme-mode == "system" && Palette.color-scheme == ColorScheme.dark);
    property <ThemeTokens> theme: {
        page: root.dark-theme ? #111827 : #F7F8FA,
        sidebar: root.dark-theme ? #1F2937 : #F1F3F5,
        card: root.dark-theme ? #273449 : #FFFFFF,
        muted: root.dark-theme ? #374151 : #F3F4F6,
        hover: root.dark-theme ? #374A63 : #EFF6FF,
        selected: root.dark-theme ? #24456B : #DBEAFE,
        border: root.dark-theme ? #4B5563 : #D9DEE7,
        border-hover: root.dark-theme ? #60A5FA : #93C5FD,
        border-focus: #2563EB,
        primary: root.dark-theme ? #F9FAFB : #1F2937,
        secondary: root.dark-theme ? #D1D5DB : #5B6472,
        tertiary: root.dark-theme ? #9CA3AF : #7B8494,
        disabled: root.dark-theme ? #6B7280 : #A0A8B5,
        on-accent: #FFFFFF,
        accent: #3B82F6,
        accent-hover: #60A5FA,
        accent-pressed: #93C5FD,
        success: #22C55E,
        success-surface: root.dark-theme ? #12351F : #F0FDF4,
        warning: root.dark-theme ? #FBBF24 : #A16207,
        warning-surface: root.dark-theme ? #42320B : #FEF3C7,
        danger: root.dark-theme ? #F87171 : #C42B1C,
        danger-surface: root.dark-theme ? #451A1A : #FEF2F2,
        info-surface: root.dark-theme ? #172E4D : #EFF6FF,
        shadow: #66000000
    };
    in-out property <int> yt-dlp-error-kind: 0;
    in-out property <int> ffmpeg-error-kind: 0;
    in-out property <int> download-directory-error-kind: 0;
    in-out property <int> proxy-error-kind: 0;
    in property <int> invalid-setting-field: -1;
    in property <int> invalid-setting-revision;
    in-out property <bool> pending-save: false;
    in-out property <string> search-url;
    in-out property <string> search-output-directory;
    in property <string> resource-name;
    in property <[StreamRow]> streams;
    in-out property <bool> search-in-progress;
    in-out property <int> selected-stream-index: -1;
    in property <[DownloadRow]> downloads;
    in property <int> settings-message-kind;
    in property <string> settings-message-argument;
    in property <int> search-message-kind;
    in property <string> search-message-argument;
    in property <int> downloads-message-kind;
    in property <string> downloads-message-argument;
    in property <int> downloads-message-task-id;
    in property <string> downloads-message-detail;
    in property <[ToastData]> toasts;

    callback save-settings();
    callback validate-settings();
    callback change-language(string);
    callback change-theme(string);
    callback reset-settings();
    callback select-yt-dlp(string);
    callback select-ffmpeg(string);
    callback select-download-directory(string);
    callback select-search-output-directory(string);
    callback search-url-edited();
    callback search();
    callback select-stream(int);
    callback create-download();
    callback refresh-downloads();
    callback start-download(int);
    callback pause-download(int);
    callback toast-dismissed(int);
    callback page-changed(int);
    callback window-closed();
    pure callback format-step-description(string) -> styled-text;

    in-out property <string> prompt-detail;
    out property <string> storage-initialization-title: @tr("Storage initialization failed");
    out property <string> storage-initialization-message: @tr("The application could not create or initialize its database file. Check the directory containing the application executable and make sure the current user can create and update files there.\n\nTechnical details: {}", root.prompt-detail);

    changed selected-page => { root.page-changed(root.selected-page); }
    changed theme-mode => {
        Palette.color-scheme = root.theme-mode == "light" ? ColorScheme.light :
                               root.theme-mode == "dark" ? ColorScheme.dark : ColorScheme.unknown;
    }

    HorizontalBox {
        spacing: 0px;
        Sidebar {
            theme: root.theme;
            selected-page <=> root.selected-page;
            refresh-downloads => { root.refresh-downloads(); }
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.selected-page == 0 : WelcomePage {
                theme: root.theme;
                format-step-description(description) => { root.format-step-description(description) }
            }
            if root.selected-page == 1 : SearchPage {
                theme: root.theme;
                url <=> root.search-url;
                output-directory <=> root.search-output-directory;
                default-download-directory: root.default-download-directory;
                resource-name: root.resource-name;
                streams: root.streams;
                search-in-progress: root.search-in-progress;
                selected-stream-index: root.selected-stream-index;
                message-kind: root.search-message-kind;
                message-argument: root.search-message-argument;
                url-edited => { root.search-url-edited(); }
                select-output-directory(title) => { root.select-search-output-directory(title); }
                search => { root.search(); }
                select-stream(index) => { root.select-stream(index); }
                create-download => { root.create-download(); }
            }
            if root.selected-page == 2 : DownloadsPage {
                theme: root.theme;
                downloads: root.downloads;
                message-kind: root.downloads-message-kind;
                message-argument: root.downloads-message-argument;
                message-task-id: root.downloads-message-task-id;
                message-detail: root.downloads-message-detail;
                refresh => { root.refresh-downloads(); }
                start(id) => { root.start-download(id); }
                pause(id) => { root.pause-download(id); }
            }
            if root.selected-page == 3 : settings-page := SettingsPage {
                theme: root.theme;
                theme-mode <=> root.theme-mode;
                yt-dlp-path <=> root.yt-dlp-path;
                ffmpeg-path <=> root.ffmpeg-path;
                default-download-directory <=> root.default-download-directory;
                proxy <=> root.proxy;
                max-concurrency <=> root.max-concurrency;
                language <=> root.language;
                yt-dlp-error-kind <=> root.yt-dlp-error-kind;
                ffmpeg-error-kind <=> root.ffmpeg-error-kind;
                download-directory-error-kind <=> root.download-directory-error-kind;
                proxy-error-kind <=> root.proxy-error-kind;
                invalid-field: root.invalid-setting-field;
                invalid-revision: root.invalid-setting-revision;
                pending-save: root.pending-save;
                message-kind: root.settings-message-kind;
                message-argument: root.settings-message-argument;
                save => { root.save-settings(); }
                change-language(language) => { root.change-language(language); }
                change-theme(theme) => { root.change-theme(theme); }
                reset => { root.reset-settings(); }
                select-yt-dlp(title) => { root.select-yt-dlp(title); }
                select-ffmpeg(title) => { root.select-ffmpeg(title); }
                select-download-directory(title) => { root.select-download-directory(title); }
            }
        }
    }

    ToastHost {
        theme: root.theme;
        toasts: root.toasts;
        dismissed(id) => { root.toast-dismissed(id); }
        width: root.width;
        height: root.height;
        z: 10;
    }
}

export component PromptWindow inherits Window {
    in property <string> prompt-title;
    in property <string> prompt-message;
    callback confirmed();

    title: root.prompt-title;
    min-width: 620px;
    max-width: 620px;
    min-height: 250px;
    max-height: 250px;

    VerticalBox {
        padding: 24px;
        spacing: 14px;

        Rectangle {
            vertical-stretch: 1;
            background: #f7f7f7;
            border-width: 1px;
            border-color: #dedede;
            border-radius: 6px;
            TextEdit {
                width: parent.width;
                height: parent.height;
                text: root.prompt-message;
                read-only: true;
                wrap: word-wrap;
            }
        }
        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            Button {
                height: 36px;
                text: @tr("OK");
                primary: true;
                clicked => { root.confirmed(); }
            }
        }
    }
}
