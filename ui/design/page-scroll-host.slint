import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// 每个页面独立使用一个滚动宿主；@children 是页面内容插槽，侧栏不会进入滚动区域。
export component PageScrollHost inherits Rectangle {
    width: 100%;
    height: 100%;
    min-width: 50px;
    min-height: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    background: Theme.background-primary;

    ScrollView {
        width: parent.width;
        height: parent.height;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

        Rectangle {
            x: Theme.scroll-content-padding;
            y: Theme.scroll-content-padding;
            width: max(parent.width - 2 * Theme.scroll-content-padding, 1px);
            min-height: max(parent.height - 2 * Theme.scroll-content-padding, 1px);
            @children
        }
    }
}
