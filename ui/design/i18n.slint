// Rust 侧把 locale 和最终文案注入这里；Slint 组件只消费这些属性。
// 默认空文本避免在资源初始化前显示未解析的 key。
export global I18n {
    in-out property <string> locale: "zh-CN";
    in-out property <string> app-title: "";
    in-out property <string> nav-welcome: "";
    in-out property <string> nav-configure: "";
    in-out property <string> nav-search: "";
    in-out property <string> nav-tasks: "";
    in-out property <string> welcome-title: "";
    in-out property <string> welcome-introduction: "";
    in-out property <string> welcome-step-prefix: "";
    in-out property <string> welcome-step-configure-number: "";
    in-out property <string> welcome-step-configure-description: "";
    in-out property <string> welcome-step-configure-page: "";
    in-out property <string> welcome-step-search-number: "";
    in-out property <string> welcome-step-search-description: "";
    in-out property <string> welcome-step-search-page: "";
    in-out property <string> welcome-step-tasks-number: "";
    in-out property <string> welcome-step-tasks-description: "";
    in-out property <string> welcome-step-tasks-page: "";
    in-out property <string> welcome-dependencies-title: "";
    in-out property <string> welcome-dependency-slint: "";
    in-out property <string> welcome-dependency-webbrowser: "";
    in-out property <string> welcome-dependency-windows-sys: "";
    in-out property <string> welcome-dependency-slint-build: "";
    in-out property <string> welcome-thanks: "";
    in-out property <string> welcome-project-label: "";
    in-out property <string> welcome-project-url: "";
}
