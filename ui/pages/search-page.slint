import { Button, LineEdit } from "std-widgets.slint";
import { I18n } from "../design/i18n.slint";
import { Theme } from "../design/theme.slint";

export struct SearchResultRow {
    format-id: string,
    format-note: string,
    extension: string,
    resolution: string,
    bitrate: string,
    file-size: string,
    video-codec: string,
    audio-codec: string,
}

component SearchField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    in property <string> error: "";
    in property <string> browse-label: "";
    in property <string> default-label: "";
    in property <bool> enabled: true;
    in property <bool> inline: false;
    callback edited(string);
    callback browse-clicked();
    callback default-clicked();
    spacing: Theme.spacing-small;

    Text {
        text: root.label;
        color: Theme.text-primary;
        font-family: Theme.ui-font-family;
        font-size: Theme.font-size-body;
        height: Theme.body-line-box;
        vertical-alignment: center;
    }
    if root.inline : HorizontalLayout {
        height: Theme.control-min-height;
        spacing: Theme.spacing-small;
        LineEdit {
            horizontal-stretch: 1;
            min-width: 240px;
            height: Theme.control-min-height;
            enabled: root.enabled;
            text <=> root.value;
            placeholder-text: root.placeholder;
            edited => { root.edited(self.text); }
        }
        Button { text: root.browse-label; enabled: root.enabled; clicked => { root.browse-clicked(); } }
        Button { text: root.default-label; enabled: root.enabled; clicked => { root.default-clicked(); } }
    }
    if !root.inline : LineEdit {
        height: Theme.control-min-height;
        enabled: root.enabled;
        text <=> root.value;
        placeholder-text: root.placeholder;
        edited => { root.edited(self.text); }
    }
    if !root.inline && (root.browse-label != "" || root.default-label != "") : HorizontalLayout {
        height: Theme.control-min-height;
        spacing: Theme.spacing-small;
        Button { text: root.browse-label; visible: root.browse-label != ""; enabled: root.enabled; clicked => { root.browse-clicked(); } }
        Button { text: root.default-label; visible: root.default-label != ""; enabled: root.enabled; clicked => { root.default-clicked(); } }
        Rectangle { horizontal-stretch: 1; }
    }
    Text {
        text: root.error;
        color: Theme.danger;
        font-family: Theme.ui-font-family;
        font-size: Theme.font-size-body;
        height: root.error == "" ? 0px : Theme.body-line-box;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

component SearchSortHeaderCell inherits Rectangle {
    in property <string> label;
    in property <int> column;
    in property <int> sort-column: -1;
    in property <int> sort-direction: 0;
    callback clicked(int);
    height: Theme.control-min-height;
    border-width: root.sort-column == root.column ? Theme.focus-ring-width : 0px;
    border-color: Theme.focus-ring;
    background: transparent;

    Text {
        x: Theme.spacing-small;
        width: parent.width - 2 * Theme.spacing-small;
        height: parent.height;
        text: root.label + (root.sort-column == root.column && root.sort-direction == 1 ? " ↑" : root.sort-column == root.column && root.sort-direction == 2 ? " ↓" : "");
        color: root.sort-column == root.column ? Theme.accent : Theme.text-secondary;
        font-family: Theme.ui-font-family;
        font-size: Theme.font-size-body;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - Theme.border-width-default;
        y: 0px;
        width: Theme.border-width-default;
        height: parent.height;
        background: Theme.border-default;
        visible: root.column < 5;
    }
    TouchArea {
        clicked => { root.clicked(root.column); }
    }
}

component SearchResultCell inherits Rectangle {
    in property <string> text;
    in property <string> font-family: Theme.ui-font-family;
    in property <bool> divider: true;
    horizontal-stretch: 1;
    background: transparent;

    Text {
        x: Theme.spacing-small;
        width: parent.width - 2 * Theme.spacing-small;
        height: parent.height;
        text: root.text;
        color: Theme.text-primary;
        font-family: root.font-family;
        font-size: Theme.font-size-body;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - Theme.border-width-default;
        y: 0px;
        width: Theme.border-width-default;
        height: parent.height;
        background: Theme.border-default;
        visible: root.divider;
    }
}

export component SearchPage inherits Rectangle {
    callback search-requested();
    callback stop-requested();
    callback browse-download-requested();
    callback use-default-download-requested();
    callback download-requested();
    callback url-edited(string);
    callback download-path-edited(string);
    callback result-selected(int);
    callback result-sort-requested(int);

    in-out property <string> url: "";
    in-out property <string> download-path: "";
    in property <string> path-error: "";
    in property <string> video-title: "";
    in property <string> status-text: "";
    in property <int> status-kind: 0;
    in property <bool> busy: false;
    in property <bool> can-search: false;
    in property <bool> can-download: false;
    in property <int> selected-index: -1;
    in property <int> sort-column: -1;
    in property <int> sort-direction: 0;
    in property <[SearchResultRow]> results: [];
    out property <length> intrinsic-height: content.preferred-height;
    private property <length> button-width: Theme.font-size-body * 8 + 2 * Theme.spacing-medium;
    private property <length> min-editor-width: 240px;
    private property <bool> inline: self.width >= button-width + min-editor-width + Theme.spacing-small;
    private property <bool> path-inline: self.width >= 2 * button-width + min-editor-width + 2 * Theme.spacing-small;

    height: content.preferred-height;
    background: transparent;

    content := VerticalLayout {
        height: parent.height;
        spacing: Theme.spacing-large;

        Text {
            text: I18n.search-title;
            color: Theme.text-primary;
            font-family: Theme.ui-font-family;
            font-size: Theme.font-size-display;
            height: Theme.font-size-display * 1.2;
        }
        Text {
            text: I18n.search-introduction;
            color: Theme.text-secondary;
            font-family: Theme.ui-font-family;
            font-size: Theme.font-size-body-large;
            height: Theme.body-line-box;
            wrap: word-wrap;
        }

        Rectangle {
            height: search-content.preferred-height + 2 * Theme.spacing-medium;
            background: Theme.surface-primary;
            border-width: Theme.border-width-default;
            border-color: Theme.border-default;
            border-radius: Theme.corner-radius-medium;
            search-content := VerticalLayout {
                x: Theme.spacing-medium;
                y: Theme.spacing-medium;
                width: parent.width - 2 * Theme.spacing-medium;
                spacing: Theme.spacing-medium;
                Text {
                    text: I18n.search-url-label;
                    color: Theme.text-primary;
                    font-family: Theme.ui-font-family;
                    font-size: Theme.font-size-body;
                    height: Theme.body-line-box;
                    vertical-alignment: center;
                }
                if root.inline : HorizontalLayout {
                    height: Theme.control-min-height;
                    spacing: Theme.spacing-small;
                    LineEdit {
                        horizontal-stretch: 1;
                        min-width: root.min-editor-width;
                        height: Theme.control-min-height;
                        enabled: !root.busy;
                        text <=> root.url;
                        placeholder-text: I18n.search-url-placeholder;
                        edited => { root.url-edited(self.text); }
                    }
                    Button {
                        text: root.busy ? I18n.search-stop : I18n.search-start;
                        enabled: root.busy || root.can-search;
                        clicked => { if (root.busy) { root.stop-requested(); } else { root.search-requested(); } }
                    }
                }
                if !root.inline : LineEdit {
                    height: Theme.control-min-height;
                    enabled: !root.busy;
                    text <=> root.url;
                    placeholder-text: I18n.search-url-placeholder;
                    edited => { root.url-edited(self.text); }
                }
                if !root.inline : HorizontalLayout {
                    height: Theme.control-min-height;
                    spacing: Theme.spacing-small;
                    Button {
                        text: root.busy ? I18n.search-stop : I18n.search-start;
                        enabled: root.busy || root.can-search;
                        clicked => { if (root.busy) { root.stop-requested(); } else { root.search-requested(); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: root.status-text;
                    color: root.status-kind == 1 ? Theme.success : root.status-kind == 2 ? Theme.warning : Theme.accent;
                    font-family: Theme.ui-font-family;
                    font-size: Theme.font-size-body;
                    height: root.status-text == "" ? 0px : Theme.body-line-box;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            height: results-content.preferred-height + 2 * Theme.spacing-medium;
            background: Theme.surface-primary;
            border-width: Theme.border-width-default;
            border-color: Theme.border-default;
            border-radius: Theme.corner-radius-medium;
            results-content := VerticalLayout {
                x: Theme.spacing-medium;
                y: Theme.spacing-medium;
                width: parent.width - 2 * Theme.spacing-medium;
                spacing: Theme.spacing-small;

                Text {
                    text: I18n.search-results-title;
                    color: Theme.text-primary;
                    font-family: Theme.ui-font-family;
                    font-size: Theme.font-size-title-small;
                    font-weight: FontWeight.bold;
                    height: Theme.title-line-box;
                }
                Rectangle {
                    height: Theme.control-min-height;
                    background: Theme.surface-elevated;
                    border-width: Theme.border-width-default;
                    border-color: Theme.border-default;
                    border-radius: Theme.corner-radius-small;
                    HorizontalLayout {
                        x: Theme.spacing-small;
                        width: parent.width - 2 * Theme.spacing-small;
                        height: parent.height;
                        spacing: Theme.spacing-small;
                        SearchSortHeaderCell { label: I18n.search-format-id; column: 0; sort-column: root.sort-column; sort-direction: root.sort-direction; horizontal-stretch: 1; clicked(column) => { root.result-sort-requested(column); } }
                        SearchSortHeaderCell { label: I18n.search-format-note; column: 1; sort-column: root.sort-column; sort-direction: root.sort-direction; horizontal-stretch: 2; clicked(column) => { root.result-sort-requested(column); } }
                        SearchSortHeaderCell { label: I18n.search-extension; column: 2; sort-column: root.sort-column; sort-direction: root.sort-direction; horizontal-stretch: 1; clicked(column) => { root.result-sort-requested(column); } }
                        SearchSortHeaderCell { label: I18n.search-resolution; column: 3; sort-column: root.sort-column; sort-direction: root.sort-direction; horizontal-stretch: 2; clicked(column) => { root.result-sort-requested(column); } }
                        SearchSortHeaderCell { label: I18n.search-bitrate; column: 4; sort-column: root.sort-column; sort-direction: root.sort-direction; horizontal-stretch: 1; clicked(column) => { root.result-sort-requested(column); } }
                        SearchSortHeaderCell { label: I18n.search-file-size; column: 5; sort-column: root.sort-column; sort-direction: root.sort-direction; horizontal-stretch: 1; clicked(column) => { root.result-sort-requested(column); } }
                        SearchResultCell { text: I18n.search-video-codec; font-family: Theme.ui-font-family; horizontal-stretch: 1; divider: true; }
                        SearchResultCell { text: I18n.search-audio-codec; font-family: Theme.ui-font-family; horizontal-stretch: 1; divider: false; }
                    }
                }
                table-rows := VerticalLayout {
                    spacing: Theme.spacing-compact;
                    for row[index] in root.results : Rectangle {
                    height: Theme.control-min-height;
                    border-radius: Theme.corner-radius-small;
                    border-width: index == root.selected-index ? Theme.focus-ring-width : Theme.border-width-default;
                    border-color: index == root.selected-index ? Theme.focus-ring : Theme.border-default;
                    background: index == root.selected-index ? Theme.surface-elevated : Theme.surface-primary;
                    HorizontalLayout {
                        x: Theme.spacing-small;
                        width: parent.width - 2 * Theme.spacing-small;
                        height: parent.height;
                        spacing: Theme.spacing-small;
                        SearchResultCell { text: row.format-id; font-family: Theme.mono-font-family; horizontal-stretch: 1; }
                        SearchResultCell { text: row.format-note; horizontal-stretch: 2; }
                        SearchResultCell { text: row.extension; horizontal-stretch: 1; }
                        SearchResultCell { text: row.resolution; horizontal-stretch: 2; }
                        SearchResultCell { text: row.bitrate; horizontal-stretch: 1; }
                        SearchResultCell { text: row.file-size; horizontal-stretch: 1; }
                        SearchResultCell { text: row.video-codec; font-family: Theme.mono-font-family; horizontal-stretch: 1; }
                        SearchResultCell { text: row.audio-codec; font-family: Theme.mono-font-family; horizontal-stretch: 1; divider: false; }
                    }
                    TouchArea { clicked => { root.result-selected(index); } }
                }
                }
                if root.video-title != "" : Text {
                    text: I18n.search-video-title + ": " + root.video-title;
                    color: Theme.text-primary;
                    font-family: Theme.ui-font-family;
                    font-size: Theme.font-size-body-large;
                    height: Theme.body-line-box;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.results.length == 0 : Text {
                    text: I18n.search-no-results;
                    color: Theme.text-muted;
                    font-family: Theme.ui-font-family;
                    font-size: Theme.font-size-body;
                    height: Theme.body-line-box;
                }
            }
        }

        Rectangle {
            height: path-content.preferred-height + 2 * Theme.spacing-medium;
            background: Theme.surface-primary;
            border-width: Theme.border-width-default;
            border-color: Theme.border-default;
            border-radius: Theme.corner-radius-medium;
            path-content := VerticalLayout {
                x: Theme.spacing-medium;
                y: Theme.spacing-medium;
                width: parent.width - 2 * Theme.spacing-medium;
                spacing: Theme.spacing-medium;
                SearchField {
                    label: I18n.search-download-path-label;
                    placeholder: I18n.search-download-path-placeholder;
                    value <=> root.download-path;
                    error: root.path-error;
                    browse-label: I18n.search-browse-folder;
                    default-label: I18n.search-use-default-path;
                    inline: root.path-inline;
                    enabled: !root.busy;
                    edited(value) => { root.download-path-edited(value); }
                    browse-clicked => { root.browse-download-requested(); }
                    default-clicked => { root.use-default-download-requested(); }
                }
            }
        }

        Button {
            text: I18n.search-start-download;
            enabled: root.can-download && !root.busy;
            clicked => { root.download-requested(); }
        }
    }
}
